# Copy to .env and replace both placeholders with randomly generated secrets.
PG_PASS=replace-with-random-database-password
AUTHENTIK_SECRET_KEY=replace-with-random-secret-key

AUTHENTIK_TAG=2026.8.5
COMPOSE_BIND_ADDRESS=127.0.0.1
COMPOSE_PORT_HTTP=9001
COMPOSE_PORT_HTTPS=9443
AUTHENTIK_ERROR_REPORTING__ENABLED=false

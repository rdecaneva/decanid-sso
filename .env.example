# Copy to .env and replace both placeholders with randomly generated secrets.
PG_PASS=replace-with-random-database-password
AUTHENTIK_SECRET_KEY=replace-with-random-secret-key

AUTHENTIK_TAG=2026.8.5
COMPOSE_BIND_ADDRESS=127.0.0.1
COMPOSE_PORT_HTTP=9001
COMPOSE_PORT_HTTPS=9443
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Resend SMTP: enable in .env only after verifying the sending domain.
# Use a sending-only API key restricted to that domain as the SMTP password.
# AUTHENTIK_EMAIL__HOST=smtp.resend.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=resend
# AUTHENTIK_EMAIL__PASSWORD=replace-with-domain-scoped-sending-key
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__USE_SSL=false
# AUTHENTIK_EMAIL__TIMEOUT=30
# AUTHENTIK_EMAIL__FROM=decanID <noreply@mail.decaneva.cloud>
